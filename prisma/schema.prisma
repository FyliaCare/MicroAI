  SalesMeeting          SalesMeeting[]
  SalesTask             SalesTask[]
  SalesProduct          SalesProduct[]

  @@index([stage])
  @@index([assignedTo])
  @@index([expectedCloseDate])
  @@index([actualCloseDate])
  @@index([forecastCategory])
  @@index([createdAt])
  @@index([value])
}

model SalesActivity {
  id                String              @id
