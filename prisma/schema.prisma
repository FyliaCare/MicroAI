model Quote {
  id              String    @id
  quoteNumber     String    @unique
  version         Int       @default(1)
  
  // Basic Information
  title           String
  description     String?
  status          String    @default("draft") // draft, sent, viewed, accepted, rejected, expired, converted
  category        String?   // web-dev, mobile-app, saas, consulting, etc.
  
  // Client & Project Links
  clientId        String?
  projectId       String?   @unique
  
  // Financial Details
  currency        String?   @default("USD")
  subtotal        Float?    @default(0)
  taxRate         Float?    @default(0)
  tax             Float?    @default(0)
  discountType    String?   @default("fixed") // fixed, percentage
  discount        Float?    @default(0)
  total           Float?    @default(0)
  
  // Line Items (JSON array)
  items           String?   // [{ id, name, description, category, quantity, unitPrice, total }]
  
  // Project Scope
  scopeOfWork     String?   // JSON: { summary, objectives[], deliverables[], exclusions[], assumptions[] }
  estimatedHours  Float?
  timeline        String?
  milestones      String?   // JSON array: [{ name, description, dueDate, amount }]
  
  // Technical Details
  projectType     String?
  industry        String?
  techStack       String?   // JSON array
  
  // Pricing Breakdown
  setupFee        Float     @default(0)
  developmentCost Float     @default(0)
  designCost      Float     @default(0)
  monthlyHosting  Float     @default(0)
  monthlyMaintenance Float  @default(0)
  monthlyRecurring Float    @default(0)
  yearlyRecurring Float     @default(0)
  hostingBreakdown String?  // JSON
  
  // Client Information
  clientName      String?
  clientEmail     String?
  clientCompany   String?
  clientPhone     String?
  clientAddress   String?
  contactPerson   String?
  
  // Company Branding
  companyName     String?
  companyEmail    String?
  companyPhone    String?
  companyAddress  String?
  companyWebsite  String?
  companyLogo     String?
  brandColor      String?   @default("#4F46E5")
  
  // Terms & Conditions
  terms           String?   // JSON: { payment, warranty, support, revisions, cancellation, ip, confidentiality }
  paymentTerms    String?
  depositAmount   Float?
  depositPercent  Float?
  freeSupportMonths Int?    @default(3)
  includedRevisions Int?    @default(2)
  revisionCost    Float?
  warrantyTerms   String?
  ipRights        String?
  confidentialityClause String?
  
  // Additional Information
  executiveSummary String?
  assumptions     String?   // JSON array
  exclusions      String?   // JSON array
  deliverables    String?   // JSON array
  notes           String?
  internalNotes   String?
  customMessage   String?
  footerText      String?
  
  // Validity & Dates
  validityDays    Int       @default(30)
  validUntil      DateTime?
  issuedAt        DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime?
  
  // Signatures
  clientSignature  String?
  clientSignedAt   DateTime?
  clientSignedBy   String?
  providerSignature String?
  providerSignedAt DateTime?
  providerSignedBy String?
  
  // Template & Style
  templateStyle   String    @default("modern")
  templateId      String?   // Link to QuoteTemplate
  
  // Metadata
  revisionsPolicy String?
  clientObligations String?
  maintenanceTerms String?
  
  // Analytics
  viewCount       Int       @default(0)
  downloadCount   Int       @default(0)
  lastViewedAt    DateTime?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  Client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  Project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions        QuoteVersion[]

  @@index([clientId])
  @@index([projectId])
  @@index([quoteNumber])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([validUntil])
  @@index([viewCount])
}

model QuoteVersion {
  id              String   @id
  quoteId         String
  version         Int
  
  // Snapshot of quote data at this version
  data            String   // Full JSON snapshot
  
  // Change tracking
  changes         String?  // JSON array of changes
  changedBy       String?  // Admin ID or name
  changeReason    String?
  
  createdAt       DateTime @default(now())
  
